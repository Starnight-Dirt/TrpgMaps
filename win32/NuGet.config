<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 源配置（仅本目录生效）。

  本工程唯一引用的包是 Microsoft.NETFramework.ReferenceAssemblies，
  它只提供「编译期参考程序集」，不会向输出目录拷贝任何文件，
  也不会成为运行期依赖 —— 打包出来的 exe 依然是纯 .NET Framework 程序。

  之所以需要它：本机只装了 v4.7.2 / v4.8 的目标包，**没有 v3.5 目标包**
  （.NET Framework 3.5 的开发人员工具包早已停止分发）。
  该包让 MSBuild 能在不额外安装任何东西的情况下以 v3.5 为目标编译，
  从而得到一台 Win7 到 Win11 都不用装运行时的可执行文件。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget-cn" value="https://nuget.azure.cn/v3/index.json" protocolVersion="3" />
    <add key="nuget-org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
