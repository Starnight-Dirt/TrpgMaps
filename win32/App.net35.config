<?xml version="1.0" encoding="utf-8"?>
<!--
  Runtime fallback chain for the .NET Framework 3.5 build of TrpgMaps.

  The assembly is compiled against v3.5 (CLR 2.0), so by default it asks for
  runtime v2.0.50727 - which is exactly what Windows 7 / Vista / XP ship with
  out of the box.

  On Windows 8 / 8.1 / 10 / 11 the ".NET Framework 3.5" feature is OFF by
  default, so the CLR 2.0 runtime is simply absent and the exe would refuse to
  start. Listing v4.0 as a second choice lets the very same IL run on the
  CLR 4.x runtime that those systems DO ship. That is safe here because the
  code only uses APIs that already existed in .NET 2.0 - no async/await, no
  System.Text.Json, no Span<T>, no LINQ-only-over-new-types.

  Net effect: one ~90 KB exe that runs on Windows 7 through Windows 11,
  32-bit and 64-bit, with nothing to install.

  NOTE: this file is copied to <exe>.config by the AttachRuntimeFallbackConfig
  target in TrpgMaps.csproj, and ONLY for the v3.5 target. The v4.0
  build must not carry it, otherwise it would try to find CLR 2.0 first.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v2.0.50727" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
